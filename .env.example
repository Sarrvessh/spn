# Keep false until migrations, storage checksums, cleanup, and staging QA pass.
TRANSFERS_ENABLED=false
PUBLIC_APP_URL=https://capsule.example

# Supabase Auth + Postgres. Service-role key is SERVER ONLY.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private S3 bucket. SHA-256 PUT validation and HEAD checksum retrieval required.
TRANSFER_S3_BUCKET=
TRANSFER_S3_REGION=
TRANSFER_S3_ACCESS_KEY_ID=
TRANSFER_S3_SECRET_ACCESS_KEY=
# Leave empty for AWS S3; compatible providers require conformance testing.
TRANSFER_S3_ENDPOINT=

# Existing small-link / collection storage and distributed rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional legacy small-envelope Blob storage, separate from private transfers.
BLOB_READ_WRITE_TOKEN=

# Notifications and authenticated cleanup jobs.
RESEND_API_KEY=
NOTIFICATION_FROM=
CRON_SECRET=
